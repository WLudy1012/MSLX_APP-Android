<?xml version="1.0" encoding="utf-8"?>
<!--
    Android 12+ 备份排除规则（dataExtractionRules）：
    settings DataStore 含加密后的 API Key（Android Keystore 加密），
    Keystore 密钥不随备份恢复，恢复后密文无法解密，故排除备份。
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude
            domain="file"
            path="datastore/settings.preferences_pb" />
        <exclude
            domain="file"
            path="datastore/settings.preferences_pb.tmp" />
        <exclude
            domain="file"
            path="logs/app.log" />
        <exclude
            domain="file"
            path="logs/app.log.1" />
        <exclude
            domain="file"
            path="logs/crash.log" />
    </cloud-backup>
    <device-transfer>
        <exclude
            domain="file"
            path="datastore/settings.preferences_pb" />
        <exclude
            domain="file"
            path="datastore/settings.preferences_pb.tmp" />
        <exclude
            domain="file"
            path="logs/app.log" />
        <exclude
            domain="file"
            path="logs/app.log.1" />
        <exclude
            domain="file"
            path="logs/crash.log" />
    </device-transfer>
</data-extraction-rules>

<?xml version="1.0" encoding="utf-8"?>
<!--
    备份排除规则：settings DataStore 中的 Daemon 配置(含加密后的 API Key)不参与云备份。
    API Key 由 Android Keystore 加密，而 Keystore 密钥不随备份恢复；
    若备份/恢复该数据，恢复后密文无法解密（密钥丢失），会导致鉴权静默失败。
-->
<full-backup-content>
    <exclude
        domain="file"
        path="datastore/settings.preferences_pb" />
    <exclude
        domain="file"
        path="datastore/settings.preferences_pb.tmp" />
    <!-- 运行日志与崩溃报告：含主机地址/文件路径/异常堆栈等本地敏感信息，不参与云备份 -->
    <exclude
        domain="file"
        path="logs/app.log" />
    <exclude
        domain="file"
        path="logs/app.log.1" />
    <exclude
        domain="file"
        path="logs/crash.log" />
</full-backup-content>

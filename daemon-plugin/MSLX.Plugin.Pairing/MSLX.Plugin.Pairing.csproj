<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>MSLX.Plugin.Pairing</AssemblyName>
    <RootNamespace>MSLX.Plugin.Pairing</RootNamespace>
    <Version>1.0.0</Version>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <PropertyGroup>
    <!-- MSLX.SDK 引用：默认使用仓库内本地参考源码 MSLX-dev/MSLX.SDK（该目录不入库）。
         其他环境可设置环境变量或 -p:MSLX_SDK_DIR=... 指向 MSLX.SDK.csproj 所在目录。 -->
    <MSLX_SDK_DIR Condition="'$(MSLX_SDK_DIR)' == ''">$(MSBuildThisFileDirectory)..\..\MSLX-dev\MSLX.SDK</MSLX_SDK_DIR>
    <MSLX_SDK_DIR>$([System.IO.Path]::GetFullPath('$(MSLX_SDK_DIR)'))</MSLX_SDK_DIR>
  </PropertyGroup>

  <Target Name="CheckSdkDir" BeforeTargets="ResolveProjectReferences">
    <Error Condition="!Exists('$(MSLX_SDK_DIR)\MSLX.SDK.csproj')"
           Text="未找到 MSLX.SDK 源码：$(MSLX_SDK_DIR)。请设置 MSLX_SDK_DIR 指向 MSLX.SDK.csproj 所在目录（如 -p:MSLX_SDK_DIR=D:\MSLX\MSLX.SDK）。" />
  </Target>

  <ItemGroup>
    <ProjectReference Include="$(MSLX_SDK_DIR)\MSLX.SDK.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- 与 Daemon 主程序同版本：插件内 ALC 把依赖委托回主程序已加载的 Newtonsoft.Json -->
    <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
  </ItemGroup>

</Project>
